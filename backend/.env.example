# Copy to .env and adjust.

DATABASE_URL=postgresql+psycopg2://gameforge:gameforge@localhost:5432/gameforge

# Comma-separated browser origins. If unset, FastAPI allows http://127.0.0.1:3000 and http://localhost:3000.
# If the React dev server runs on another port (e.g. 3001), add it or the browser will block calls and Axios may show "Network Error".
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# JWT_SECRET_KEY=replace-with-long-random-string
# JWT_EXPIRE_HOURS=8

# AI: offline | openai | local | huggingface
AI_MODE=offline

# OpenAI (hosted) — required if AI_MODE=openai and OPENAI_BASE_URL is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible local server (Ollama, LM Studio, vLLM)
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# For AI_MODE=local, base URL defaults to 11434 if unset.

# Auto-complete wall-clock limit (seconds); thread may still finish in background
# AI_AUTOCOMPLETE_TIMEOUT_SEC=120

# Hugging Face Inference API (optional)
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Optional custom inference root (default: https://api-inference.huggingface.co/models)
# HUGGINGFACE_INFERENCE_BASE=https://api-inference.huggingface.co/models
